# Server
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/balls_in_the_air
JWT_SECRET=your-secret-here-minimum-32-characters-long

# S3 / Cloudflare R2
S3_REGION=us-east-1
S3_ENDPOINT=           # Leave blank for AWS S3; set to https://<accountId>.r2.cloudflarestorage.com for R2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=balls-in-the-air-voice-notes

# Client (Vite)
VITE_API_BASE_URL=http://localhost:3001/api
